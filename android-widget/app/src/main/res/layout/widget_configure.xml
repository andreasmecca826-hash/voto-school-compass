<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#172033">
<LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Configura widget VOTO" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Scegli cosa vuoi visualizzare in questo widget." android:textColor="#D8E2F2" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/mode_spinner" android:entries="@array/widget_modes" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Tema colore" android:textColor="#D8E2F2" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/theme_spinner" android:entries="@array/widget_themes" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Tema interfaccia" android:textColor="#D8E2F2" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/interface_theme_spinner" android:entries="@array/widget_interface_themes" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Dimensione testo" android:textColor="#D8E2F2" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/text_size_spinner" android:entries="@array/widget_text_sizes" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/show_updated_check" android:text="Mostra ultimo aggiornamento" android:textColor="#D8E2F2" android:checked="true" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/glass_background_check" android:text="Sfondo iOS Glass" android:textColor="#D8E2F2" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/transparent_background_check" android:text="Sfondo trasparente" android:textColor="#D8E2F2" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/config_save" android:text="Salva" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
