<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#172033">
    <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="VOTO Widget" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Configura una volta l’app companion: le impostazioni predefinite verranno usate dai nuovi widget." android:textColor="#D8E2F2" android:textSize="15sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:text="1  •  SCEGLI COSA MOSTRARE" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#263B5A" android:padding="12dp" android:layout_marginTop="22dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Scegli il contenuto predefinito per ogni dimensione." android:textColor="#D8E2F2" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Widget piccolo" android:textColor="#D8E2F2" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/small_mode" android:entries="@array/widget_modes" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Widget grande / largo" android:textColor="#D8E2F2" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/large_mode" android:entries="@array/widget_modes" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Widget 2×2" android:textColor="#D8E2F2" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/compact_mode" android:entries="@array/widget_modes" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:text="2  •  PERSONALIZZAZIONE" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#263B5A" android:padding="12dp" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Queste sono le impostazioni grafiche predefinite." android:textColor="#D8E2F2" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Tema colore" android:textColor="#D8E2F2" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/default_theme" android:entries="@array/widget_themes" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Tema interfaccia" android:textColor="#D8E2F2" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/default_interface_theme" android:entries="@array/widget_interface_themes" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/default_glass_background" android:text="Sfondo iOS Glass" android:textColor="#D8E2F2" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/default_transparent_background" android:text="Sfondo trasparente" android:textColor="#D8E2F2" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <CheckBox android:id="@+id/default_hide_title" android:text="Nascondi titolo VOTO nei widget" android:textColor="#D8E2F2" android:checked="true" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <Button android:id="@+id/github_button" android:text="Accedi con GitHub" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/refresh_button" android:text="Aggiorna widget adesso" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/logout_button" android:text="Disconnetti questo dispositivo" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/status" android:textColor="#D8E2F2" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
