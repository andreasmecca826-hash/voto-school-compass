<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#172033">
    <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="VOTO Widget" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Accedi con il tuo account VOTO. Il widget legge i dati privati da Supabase e non usa più grades.json o link GitHub." android:textColor="#D8E2F2" android:textSize="15sp" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/email_input" android:hint="Email account VOTO" android:inputType="textEmailAddress" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#9AAAC2" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/password_input" android:hint="Password" android:inputType="textPassword" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#9AAAC2" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Widget piccolo" android:textColor="#D8E2F2" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/small_mode" android:entries="@array/widget_modes" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="Widget grande" android:textColor="#D8E2F2" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/large_mode" android:entries="@array/widget_modes" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/save_button" android:text="Accedi e aggiorna widget" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/github_button" android:text="Accedi con GitHub" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/logout_button" android:text="Disconnetti questo dispositivo" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/status" android:textColor="#D8E2F2" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
