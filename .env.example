# Server-only: non usare mai queste variabili con il prefisso VITE_.
# Il connettore può fornire SUPABASE_URL come project ref oppure come URL completo.
SUPABASE_URL=<project-ref-or-https-url>
# Il connettore Supabase usa SUPABASE_KEY; SUPABASE_SERVICE_ROLE_KEY resta supportata.
SUPABASE_KEY=<server-key>
SUPABASE_STORAGE_BUCKET=circulars
